import java.io.*;
import java.util.*;
public class Solution {
    static int[] p, lg;
    static int[][] st;
    static void manacher(String s) {
        int n = s.length();
        p = new int[n];
        int l = 0, r = -1;
        for (int i = 0; i < n; i++) {
            int k = i > r ? 0 : Math.min(p[l + r - i], r - i);
            while (i-k-1 >= 0 && i+k+1 < n &&
                   s.charAt(i-k-1) == s.charAt(i+k+1)) k++;
            p[i] = k--;
            if (i+k > r) {
                l = i-k;
                r = i+k;
            }
        }
    }
    static void build() {
        int n = p.length;
        lg = new int[n + 1];
        for (int i = 2; i <= n; i++) lg[i] = lg[i/2] + 1;
        st = new int[lg[n] + 1][n];
        st[0] = p.clone();
        for (int j = 1; j < st.length; j++)
            for (int i = 0; i + (1 << j) <= n; i++)
                st[j][i] = Math.max(st[j-1][i],
                    st[j-1][i + (1 << (j-1))]);
    }
    static int max(int l, int r) {
        if (l > r) return 0;
        int j = lg[r-l+1];
        return Math.max(st[j][l], st[j][r-(1<<j)+1]);
    }
    public static void main(String[] args) throws Exception {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int n = Integer.parseInt(br.readLine());
        String s = br.readLine();
        String t = s + s;
        StringBuilder x = new StringBuilder("#");
        for (char c : t.toCharArray()) x.append(c).append('#');
        manacher(x.toString());
        build();
        for (int i = 0; i < n; i++) {
            int a = 2 * i, b = 2 * (i + n - 1) + 2;
            int lo = 1, hi = n, ans = 1;
            while (lo <= hi) {
                int k = (lo + hi) / 2;
                if (max(a + k, b - k) >= k) {
                    ans = k;
                    lo = k + 1;
                } else hi = k - 1;
            }
            System.out.println(ans);
        }
    }
}
